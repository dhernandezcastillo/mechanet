# mechanet preset "pbe-d3", stage 01_loose: a coarse pre-relaxation from the generated start.
# Review every tag for your system before production runs. Per stage, mechanet itself sets
# ISTART/ICHARG, LWAVE/LCHARG and LMAXMIX; MAGMOM comes from vasp.magmom_by_element and the
# LDAU arrays from vasp.dft_u in project.yaml. Parallelization tags (NCORE, KPAR) belong in
# vasp.common_overrides, since they depend on the cluster.
SYSTEM = RuO2_110
GGA = PE            # PBE
ENCUT = 500
PREC = Normal
LASPH = .TRUE.
ISPIN = 2
ISMEAR = 0
SIGMA = 0.05
ALGO = Normal
EDIFF = 1E-4
NELM = 60
IVDW = 12           # DFT-D3 with Becke-Johnson damping
LDIPOL = .TRUE.     # dipole correction along the surface normal (lattice vector 3)
IDIPOL = 3
LREAL = Auto
ISYM = 0
IBRION = 2
ISIF = 2
NSW = 60
EDIFFG = -0.05
LORBIT = 11
